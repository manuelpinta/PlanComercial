# Copia a .env.local para desarrollo. En Vercel: Settings → Environment Variables

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=tu_usuario
MYSQL_PASSWORD=tu_password
MYSQL_DATABASE=plan_comercial

# Si tu proveedor exige TLS (p. ej. algunos hosts en la nube)
# MYSQL_SSL=true
# MYSQL_SSL_REJECT_UNAUTHORIZED=false

# Opcional
# MYSQL_POOL_LIMIT=5
