# Copia a .env.local para desarrollo. En Vercel: Project → Settings → Environment Variables (Production + Preview).

# --- Auth0 (aplicación tipo Regular Web Application) ---
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
# Tras logout Auth0 redirige aquí. Por defecto la app usa solo el origen (ej. http://localhost:3000).
# Si quieres /login explícito, descomenta y añade esa URL en Auth0 → Allowed Logout URLs:
# AUTH0_POST_LOGOUT_REDIRECT=/login

# Opcional: mismo API Identifier que en la otra app si quieres audience + RBAC en los tokens
AUTH0_AUDIENCE=
# Alias opcional; si lo usas, suele ser el mismo valor que AUTH0_AUDIENCE
COLORCENTER_API_IDENTIFIER=

# Solo usuarios con este rol pueden usar la app y las APIs (por defecto Comercial; la comparación ignora mayúsculas/minúsculas)
AUTH0_REQUIRED_ROLE=Comercial

# Claim del ID token donde Auth0 envía la lista de roles (Action Post-Login). Ej: https://tu-dominio/roles
# Si lo dejas vacío, se buscan claims "roles" y cualquier claim cuya clave termine en "/roles".
# Los roles del dashboard no entran solos al token: necesitas una Action que los copie al ID token (RBAC + audience).
AUTH0_ROLES_CLAIM=

# Organizations (opcional): si usas Auth0 Organizations, define el ID de org para el login
AUTH0_ORGANIZATIONS_ENABLED=true
AUTH0_ORGANIZATION=

# Machine-to-Management (opcional): solo si otro servicio o script llama a Auth0 Management API.
# Esta app no necesita M2M solo para comprobar el rol si los roles van en el ID token (claim).
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
AUTH0_MANAGEMENT_SCOPES=read:organization_members read:organizations read:users read:roles read:role_members

# --- MySQL (planes y autollenado) ---
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=

# Base por defecto del pool (si no pones MYSQL_DB_PC_PROYECTOSAPPS, se usa proyectosapps)
MYSQL_DATABASE=

# Tabla planes_comerciales: catálogo (por defecto proyectosapps)
MYSQL_DB_PC_PROYECTOSAPPS=proyectosapps

# Autollenado: nombres de catálogos en el servidor MySQL
MYSQL_DB_PC_COMUN=comun
MYSQL_DB_PC_ESTA=estapinta
MYSQL_DB_PC_PDV=pdv

# Si el host exige TLS
# MYSQL_SSL=true
# MYSQL_SSL_REJECT_UNAUTHORIZED=false

# Opcional
# MYSQL_POOL_LIMIT=5
